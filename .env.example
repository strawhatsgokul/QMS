# QMS Dashboard — Environment Configuration
# Copy this file to .env and replace values as needed.
# docker compose loads .env automatically.

# A long, random string used to sign JWT tokens.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change_this_to_a_secure_random_string

# SQLite database path (relative to the api container's working directory).
# WAL mode improves concurrent read performance.
DATABASE_URL=file:./data/qms.db?connection_limit=10&journal_mode=WAL

# Runtime environment.
NODE_ENV=production
