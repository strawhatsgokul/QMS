# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veyon_aw_dashboard"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Veyon
VEYON_CLI_PATH="veyon-cli"
VEYON_API_KEY=""

# ActivityWatch
ACTIVITYWATCH_API_URL="http://localhost:5600/api"
ACTIVITYWATCH_API_KEY=""

# Encryption
ENCRYPTION_KEY="your-32-char-encryption-key-for-sensitive-data"

# CORS
CORS_ORIGIN="http://localhost:3000"
