# Server
PORT=4000
NODE_ENV=production

# Database (SQLite for single-server, PostgreSQL for HA)
# SQLite (default):
DATABASE_URL="file:./data/qms.db?connection_limit=10&journal_mode=WAL"
# PostgreSQL (alternative):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veyon_aw_dashboard"

# JWT
JWT_SECRET="change-this-to-a-random-64-char-string"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Veyon
VEYON_CLI_PATH="veyon-cli"
VEYON_API_KEY=""
VEYON_WEBAPI_URL="http://localhost:11080/api/v1"
VEYON_PRIVATE_KEY_PATH=""
VEYON_KEY_NAME="dashboard-key"

# ActivityWatch
ACTIVITYWATCH_API_URL="http://localhost:5600/api"
ACTIVITYWATCH_API_KEY=""

# Agent (shared secret for agent registration)
AGENT_KEY="change-this-to-a-random-32-char-string"

# Encryption (for sensitive data at rest)
ENCRYPTION_KEY="change-this-to-a-32-char-string"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Redis (optional — caching only; omit for no caching)
# REDIS_URL="redis://localhost:6379"